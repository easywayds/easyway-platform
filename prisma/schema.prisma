// Easy Way Driving School — TDLR 6-Hour Adult Course Platform
// Prisma schema — mirrors the data model in the build plan (Section 4)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EnrollmentStatus {
  active
  completed
  expired
}

enum ContentType {
  text
  video
  image
}

enum TopicStatus {
  not_started
  in_progress
  complete
}

enum AdminRole {
  admin
  compliance_reviewer
}

model Student {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  lastName     String
  firstName    String
  // Single-character middle initial, optional — matches the certificate's
  // "MI" field exactly.
  middleInitial String?
  dateOfBirth  DateTime
  // "Male" | "Female" — matches the certificate's radio button states
  // exactly, so it can be passed straight through at generation time.
  sex          String
  phone        String?
  createdAt    DateTime @default(now())

  enrollments Enrollment[]

  @@map("students")
}

model Enrollment {
  id            String            @id @default(cuid())
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id])
  status        EnrollmentStatus  @default(active)
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  // Set the moment a student passes the assessment — even if no TDLR
  // certificate number is available to assign yet. This is what lets a
  // "pending" student be found and given a number automatically once
  // Easy Way adds more to the pool.
  assessmentPassedAt DateTime?

  // Payment gate — no topic unlocks (not even Topic 1) until this is set.
  // Set only by the Square webhook confirming a completed payment, never
  // by the client, so a student can't unlock the course without actually
  // paying.
  paidAt                DateTime?
  squarePaymentLinkId   String?   @unique

  certificateId String?      @unique
  certificate   Certificate? @relation(fields: [certificateId], references: [id])

  topicProgress      TopicProgress[]
  assessmentAttempts AssessmentAttempt[]

  @@map("enrollments")
}

model Topic {
  id         String   @id @default(cuid())
  number     Int      @unique // 1-9
  title      String
  minMinutes Int
  sortOrder  Int

  content  TopicContent[]
  progress TopicProgress[]

  @@map("topics")
}

model TopicContent {
  id          String      @id @default(cuid())
  topicId     String
  topic       Topic       @relation(fields: [topicId], references: [id])
  contentType ContentType
  body        String
  sortOrder   Int

  @@map("topic_content")
}

model TopicProgress {
  id           String      @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id])
  topicId      String
  topic        Topic       @relation(fields: [topicId], references: [id])

  // Compliance-critical field: accumulated real foreground time, updated via
  // periodic client heartbeat (~every 15s while tab is visible/focused).
  secondsActive Int         @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  status        TopicStatus @default(not_started)

  @@unique([enrollmentId, topicId])
  @@map("topic_progress")
}

model AssessmentAttempt {
  id            String     @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])
  attemptNumber Int
  scorePercent  Float
  passed        Boolean
  startedAt     DateTime   @default(now())
  submittedAt   DateTime?

  // What was asked/answered, stored for audit purposes.
  answers Json

  @@map("assessment_attempts")
}

model Certificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  pdfUrl            String?

  enrollment Enrollment?

  @@map("certificates")
}

model Question {
  id           String   @id @default(cuid())
  questionText String
  // Exactly 4 strings, stored as JSON: ["choice A", "choice B", "choice C", "choice D"]
  choices      Json
  correctIndex Int
  // Loose tag back to one of the 9 topics this question relates to —
  // informational only, not used for grading.
  topicNumber  Int?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)

  @@map("questions")
}

model CertificateNumber {
  id         String    @id @default(cuid())
  // The real number Easy Way purchased from TDLR — entered by the admin,
  // never generated by this system.
  number     String    @unique
  status     String    @default("available") // available | assigned
  assignedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("certificate_numbers")
}

// Singleton row (id is always "default") holding the constants that
// appear on every certificate — set once by the admin, never per-student.
model SchoolSettings {
  id                           String  @id @default("default")
  tdlrNumber                   String?
  schoolName                   String?
  driverEdSchoolNumber         String?
  instructorName               String?
  // Stored as a base64 data URL (e.g. "data:image/png;base64,...") so no
  // separate file storage service is needed.
  instructorSignatureImage     String?
  chiefOfficialName            String?
  chiefOfficialSignatureImage  String?
  // Course price in whole US dollars (e.g. 25 = $25.00). Falls back to
  // the default in lib/square.ts if not set.
  coursePriceUsd               Int?

  @@map("school_settings")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(admin)
  createdAt    DateTime  @default(now())

  @@map("admin_users")
}
