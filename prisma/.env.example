# Neon Postgres connection string
# Get this from your Neon project dashboard (use the "pooled connection" string for DATABASE_URL,
# and the direct/non-pooled string for DIRECT_URL — Prisma migrations need the direct one).
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/easyway?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/easyway?sslmode=require"

# Long random string used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Password for the /admin/certificate-numbers page, where Easy Way enters
# TDLR-purchased certificate numbers. Pick your own — not tied to any
# student account. Generate one at randomkeygen.com if you like.
ADMIN_SECRET="replace-with-your-own-admin-password"
